# Copy to .env and edit. Every value here has a working default, so an empty
# .env (or none at all) still gives you a running app on http://<ip>/parserIICS
#
#   cp .env.example .env
#   docker compose up -d --build

# Host port nginx binds. Change if something already owns port 80.
HTTP_PORT=80

# The path the app is served under. Change both this and deploy/nginx.conf
# if you want a different URL.
URL_PREFIX=/parserIICS

# Largest upload accepted. Raise deploy/nginx.conf's client_max_body_size too.
MAX_UPLOAD_MB=200

# How long generated documents stay downloadable before they are swept.
JOB_TTL_HOURS=6

# Optional: enables the "draft the integration purpose with AI" checkbox.
# Without a key the app runs exactly the same and leaves those fields for a
# human to fill in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set only for an Azure OpenAI or gateway endpoint.
OPENAI_BASE_URL=
